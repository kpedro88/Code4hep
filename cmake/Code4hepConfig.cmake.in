# Code4hepConfig.cmake.in
# CMake package config template for the Code4hep package.
# Generated by CMake's configure_package_config_file(); do not edit directly.
#
# After find_package(Code4hep REQUIRED):
#   - Code4hepBuildFunctions.cmake is loaded (all c4h_* functions available).
#   - Stitched and Code4hep are registered as known upstreams, so both
#     FWCore/... and Code4hep/... DEPS shorthands resolve automatically.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# pybind11 must precede stitched: StitchedTargets.cmake references
# pybind11::pybind11 but Stitched's own config omits find_dependency(pybind11).
find_dependency(pybind11 REQUIRED)

# Stitched is a mandatory upstream; load it transitively.
find_dependency(Stitched REQUIRED)

# Load the Code4hep build-helper functions.
include("${CMAKE_CURRENT_LIST_DIR}/Code4hepBuildFunctions.cmake")

# Load the installed Code4hep targets (libraries, executables).
include("${CMAKE_CURRENT_LIST_DIR}/Code4hepTargets.cmake")

# Backfill INTERFACE_INCLUDE_DIRECTORIES on any upstream targets whose
# CMake config omits that property (Stitched per-module targets, etc.).
c4h_backfill_ext_includes(PACKAGE pybind11)
c4h_backfill_ext_includes(PACKAGE stitched)

# Register upstreams for DEPS shorthand resolution:
#   FWCore/Utilities  -> stitched::stitched_FWCore_Utilities  (or Stitched::FWCore_Utilities)
#   Code4hep/PodioUtilities -> code4hep::PodioUtilities  (installed)
c4h_register_upstream(Stitched)
c4h_register_upstream(Code4hep)

check_required_components(Code4hep)
