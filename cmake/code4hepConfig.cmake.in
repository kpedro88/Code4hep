# code4hepConfig.cmake.in
# CMake package config template for the code4hep package.
# Generated by CMake's configure_package_config_file(); do not edit directly.
#
# After find_package(code4hep REQUIRED):
#   - Code4HepBuildFunctions.cmake is loaded (all c4h_* functions available).
#   - stitched is found and c4h_register_upstream(stitched) is called, so
#     FWCore/... DEPS shorthand resolves automatically without any explicit
#     upstream registration in downstream CMakeLists.txt files.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Stitched is a mandatory upstream; load it transitively.
find_dependency(stitched REQUIRED)

# Load the Code4HEP build-helper functions.
include("${CMAKE_CURRENT_LIST_DIR}/Code4HepBuildFunctions.cmake")

# Load the installed code4hep targets (libraries, executables).
include("${CMAKE_CURRENT_LIST_DIR}/code4hepTargets.cmake")

# Register stitched as a known upstream for DEPS shorthand resolution
# (e.g. FWCore/Common -> stitched::FWCore_Common).
# Any downstream repo that does find_package(code4hep REQUIRED) gets this
# resolution automatically.
c4h_register_upstream(stitched)

check_required_components(code4hep)
